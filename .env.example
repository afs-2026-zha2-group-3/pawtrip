# 复制为根目录 .env；前端开发服务器（vite dev）会自动加载。
# 已存在的 shell 环境变量优先于 .env。
# 复制为 .env 后填写真实的高德 Web 服务 API Key；请勿提交真实密钥。
AMAP_API_KEY=your-amap-api-key

# 行程规划 Agent（仅服务端读取，勿放入客户端变量）
BIGMODEL_API_KEY=your-bigmodel-api-key
PAWTRIP_API_BASE_URL=http://localhost:8080
# bigmodel | fake（fake 仅用于本地/E2E，生产禁用）
PAWTRIP_AGENT_PROVIDER=bigmodel
# 可选：覆盖默认模型 glm-5.3
# PAWTRIP_AGENT_MODEL=glm-5.3
